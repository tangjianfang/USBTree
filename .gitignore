*.fm.tmp
gs.tmp.json
*.tmp
!tools/**
__pycache__/
*.pyc

# tech-doc 重建的本地源笔记、备份与可选截图不入库
tech-doc/build/os-kb/
tech-doc/**/*.bak
tech-doc/shots-check/

# 静态站点（site/）的依赖与构建产物见 site/.gitignore

