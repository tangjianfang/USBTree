<dialog class="mz-dialog" aria-label="放大查看图表">
  <div class="mz-bar">
    <span class="mz-hint">滚轮/双指缩放 · 拖动平移 · 双击复位</span>
    <button type="button" data-act="in" aria-label="放大">＋</button>
    <button type="button" data-act="out" aria-label="缩小">－</button>
    <button type="button" data-act="reset" aria-label="复位">⟲</button>
    <button type="button" data-act="close" aria-label="关闭">✕</button>
  </div>
  <div class="mz-stage"></div>
</dialog>
<script>
  // 给每张渲染完成的 Mermaid 图加“放大”按钮；对话框内支持滚轮/双指缩放与拖动平移。
  const dlg = document.querySelector<HTMLDialogElement>('.mz-dialog')!;
  const stage = dlg.querySelector<HTMLDivElement>('.mz-stage')!;
  let s = 1, x = 0, y = 0, svg: SVGSVGElement | null = null;
  const apply = () => { if (svg) svg.style.transform = `translate(${x}px, ${y}px) scale(${s})`; };
  const reset = () => { s = 1; x = 0; y = 0; apply(); };
  const zoomAt = (f: number, cx = stage.clientWidth / 2, cy = stage.clientHeight / 2) => {
    const ns = Math.min(12, Math.max(0.3, s * f)); const k = ns / s;
    x = cx - k * (cx - x); y = cy - k * (cy - y); s = ns; apply();
  };
  function open(src: SVGSVGElement) {
    stage.replaceChildren();
    svg = src.cloneNode(true) as SVGSVGElement;
    svg.removeAttribute('style'); svg.setAttribute('width', '100%'); svg.setAttribute('height', '100%');
    svg.style.transformOrigin = '0 0';
    stage.append(svg); dlg.showModal(); reset();
  }
  dlg.addEventListener('click', (e) => {
    const act = (e.target as HTMLElement).closest('button')?.dataset.act;
    if (act === 'close') dlg.close(); else if (act === 'in') zoomAt(1.3); else if (act === 'out') zoomAt(1 / 1.3); else if (act === 'reset') reset();
    else if (e.target === dlg) dlg.close();
  });
  stage.addEventListener('wheel', (e) => { e.preventDefault(); const r = stage.getBoundingClientRect(); zoomAt(e.deltaY < 0 ? 1.15 : 1 / 1.15, e.clientX - r.left, e.clientY - r.top); }, { passive: false });
  stage.addEventListener('dblclick', reset);
  const pts = new Map<number, { x: number; y: number }>(); let pinch = 0;
  stage.addEventListener('pointerdown', (e) => { stage.setPointerCapture(e.pointerId); pts.set(e.pointerId, { x: e.clientX, y: e.clientY }); });
  stage.addEventListener('pointermove', (e) => {
    const p = pts.get(e.pointerId); if (!p) return;
    if (pts.size === 1) { x += e.clientX - p.x; y += e.clientY - p.y; apply(); }
    pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pts.size === 2) {
      const [a, b] = [...pts.values()]; const d = Math.hypot(a.x - b.x, a.y - b.y);
      if (pinch) { const r = stage.getBoundingClientRect(); zoomAt(d / pinch, (a.x + b.x) / 2 - r.left, (a.y + b.y) / 2 - r.top); }
      pinch = d;
    }
  });
  const up = (e: PointerEvent) => { pts.delete(e.pointerId); if (pts.size < 2) pinch = 0; };
  stage.addEventListener('pointerup', up); stage.addEventListener('pointercancel', up);

  function decorate(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>('.mermaid').forEach((el) => {
      const g = el.querySelector('svg');
      if (!g || el.dataset.mz) return;
      el.dataset.mz = '1';
      const wrap = document.createElement('div'); wrap.className = 'mz-wrap';
      el.replaceWith(wrap); wrap.append(el);
      const b = document.createElement('button'); b.type = 'button'; b.className = 'mz-btn'; b.textContent = '⤢ 放大';
      b.setAttribute('aria-label', '放大查看图表');
      b.addEventListener('click', () => open(el.querySelector('svg')!));
      wrap.append(b);
    });
  }
  new MutationObserver(() => decorate()).observe(document.body, { childList: true, subtree: true });
  decorate();
</script>
