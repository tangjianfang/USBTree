/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
/*.yaml
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
/*.mmd
  Content-Type: text/plain; charset=utf-8
/*.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
/assets/*
  Cache-Control: public, max-age=604800
/videos/*.mp4
  Cache-Control: public, max-age=86400
/videos/*.png
  Cache-Control: public, max-age=86400
/videos/*.jpg
  Cache-Control: public, max-age=86400
/videos/*.vtt
  Cache-Control: public, max-age=86400
